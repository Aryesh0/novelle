# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies (both frontend and backend)
node_modules/
.pnp
.pnp.js

# Testing
coverage/

# Production builds
build/  # Frontend build output
dist/   # If using Vite instead of Create React App

# Environment files (both frontend and backend)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS system files
.DS_Store

# Backend-specific
backend/node_modules/
backend/.env
backend/*.log

# IDE/Editor files (optional, add if present)
.idea/          # IntelliJ
.vscode/        # VSCode (keep if you want settings, or add to ignore)
*.suo           # Visual Studio
*.sln           # Visual Studio